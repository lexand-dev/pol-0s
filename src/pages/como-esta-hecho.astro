---
import { PERSONA } from '../content/persona';
import { compiledContent, frontmatter } from '../content/como-esta-hecho.md';
import Base from '../layouts/Base.astro';
import { externalLinks, withoutAppLinks } from '../lib/cv';
import { prepareHowTo } from '../lib/howto';
import TechGrid from '../os/apps/howto/TechGrid.svelte';

// La página pública de «Cómo está hecho» (S-10): se genera al compilar y se lee sin JavaScript. Los enlaces a apps (`#abrir-…`) solo tienen
// sentido dentro del escritorio, así que aquí quedan como texto. El texto sale de un archivo del repositorio, nunca de un visitante.
export const prerender = true;

const { title, description, toc, before, after } = prepareHowTo(withoutAppLinks(externalLinks(await compiledContent())), frontmatter);
---

<Base title={`${title} · ${PERSONA.osName}`} {description}>
  <main class="page">
    <nav class="top" aria-label="Navegación">
      <a href="/" data-testid="howto-home">{PERSONA.osName}</a>
      <a class="open" href="/" data-testid="howto-open-in-os">Abrir {PERSONA.osName}</a>
    </nav>

    <article class="sheet" data-testid="howto-page">
      <header>
        <h1 data-testid="howto-title">{title}</h1>
        <p class="subtitle">{description}</p>
      </header>

      <nav class="toc" aria-label="Índice" data-testid="howto-toc">
        <p class="toc-title">En este documento</p>
        <ol>
          {toc.map((entry) => <li><a href={`#${entry.id}`}>{entry.title}</a></li>)}
        </ol>
      </nav>

      <div class="prose" data-testid="howto-body">
        <Fragment set:html={before} />
        <TechGrid />
        <Fragment set:html={after} />
      </div>
    </article>
  </main>
</Base>

<style>
  /* La página se desplaza: el escritorio de Pol OS, no. */
  :global(html),
  :global(body) {
    height: auto;
    overflow: auto;
  }
  :global(body) {
    background: var(--paper-desk);
    font-size: 16px;
  }
  .page {
    min-height: 100vh;
    padding: 20px 16px 56px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    max-width: 760px;
    margin: 0 auto 16px;
    font-size: calc(15px * var(--text-scale));
  }
  .top a {
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }
  .top .open {
    color: var(--accent-text);
  }
  .sheet {
    max-width: 760px;
    margin: 0 auto;
    padding: 44px 52px 52px;
    border-radius: 4px;
    background: var(--paper-bg);
    color: var(--paper-fg);
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.2),
      0 10px 30px -12px rgba(0, 0, 0, 0.4);
    line-height: 1.65;
  }
  h1 {
    margin: 0;
    font-size: calc(30px * var(--text-scale));
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .subtitle {
    margin: 10px 0 0;
    font-size: calc(17px * var(--text-scale));
    line-height: 1.45;
    color: var(--paper-muted);
  }
  .toc {
    margin: 24px 0 8px;
    padding: 14px 18px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.045);
  }
  .toc-title {
    margin: 0 0 6px;
    font-size: calc(12px * var(--text-scale));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-muted);
  }
  .toc ol {
    margin: 0;
    padding-left: 20px;
  }
  .toc a {
    color: var(--paper-link);
  }
  .prose :global(p) {
    margin: 0 0 14px;
  }
  .prose :global(h2) {
    margin: 34px 0 10px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--paper-line);
    font-size: calc(21px * var(--text-scale));
    scroll-margin-top: 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
    padding-left: 22px;
  }
  .prose :global(li) {
    margin: 0 0 6px;
  }
  .prose :global(a) {
    color: var(--paper-link);
  }
  .prose :global(code) {
    padding: 1px 4px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.06);
    font-family: var(--mono);
    font-size: 0.9em;
  }
  @media (max-width: 520px) {
    .sheet {
      padding: 28px 20px 36px;
    }
  }
</style>
